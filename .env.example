# Dedicated QuickRCM service credential. Do not use a personal user token.
QUICKRCM_API_KEY=

# Needed only when prognocis.loginPerRun is true. Existing-session/CDP mode
# normally gets its authenticated session from the persistent remote Chrome.
PROGNOCIS_USERNAME=
PROGNOCIS_PASSWORD=

# Required verbatim only after a supervised test-patient canary is approved.
# Leave blank for probe mode.
CLINICAL_WRITE_ACK=

