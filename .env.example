# QuickRCM/QuickScribe is authenticated manually in the persistent remote
# Chrome through noVNC. No QuickRCM API key is used by this project.

# Needed only when prognocis.loginPerRun is true. The normal browser-to-browser
# mode also authenticates PrognoCIS manually through noVNC.
PROGNOCIS_USERNAME=
PROGNOCIS_PASSWORD=

# Required verbatim only after a supervised test-patient canary is approved.
# Leave blank for probe mode.
CLINICAL_WRITE_ACK=
