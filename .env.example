# Required for care1960.input=http. Use credentials from the same backend.
# Supabase gateway anon key (apikey header).
CARE1960_API_KEY=
# Registered, live Care1960 tenant API JWT (Authorization: Bearer header).
CARE1960_BEARER_TOKEN=

# PrognoCIS uses the existing authenticated browser unless loginPerRun=true.
PROGNOCIS_USERNAME=
PROGNOCIS_PASSWORD=

# Required verbatim for draft writes; leave blank for probe/response validation.
# I_ACKNOWLEDGE_ATTESTED_CLINICAL_DRAFT_WRITES
CLINICAL_WRITE_ACK=
