{
  "name": "care1960-prognocis-writeback",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Care1960 API clinical narratives written into exact PrognoCIS draft encounters.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "probe": "node src/cli.mjs probe",
    "run": "node src/cli.mjs run",
    "validate:config": "node src/cli.mjs validate-config",
    "test": "node --test",
    "check": "node --check src/cli.mjs && node --test",
    "validate:response": "node src/cli.mjs validate-response"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "playwright": "^1.55.0"
  }
}
